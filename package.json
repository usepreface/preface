{
  "name": "preface",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm check:root && turbo run lint typecheck build",
    "check:root": "pnpm format:check && oxlint --deny-warnings . && tsc --noEmit -p tsconfig.json && pnpm typecheck:tests",
    "dev": "turbo run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings . && turbo run lint",
    "lint:fix": "oxlint --fix .",
    "prepare": "lefthook install",
    "test": "turbo run test",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm typecheck:tests && turbo run typecheck",
    "test:postgres": "node tooling/testing/run-postgres.ts",
    "test:auth": "turbo run build --filter=@usepreface/server && playwright test",
    "test:uikit": "playwright test --config apps/uikit/playwright.config.ts",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test:dashboard": "turbo run build --filter=@usepreface/server && pnpm --filter @usepreface/dashboard build:test && playwright test --config playwright.dashboard.config.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.64.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "catalog:",
    "@usepreface/protocol": "workspace:*",
    "effect": "catalog:",
    "klarity": "catalog:",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "testcontainers": "12.2.1",
    "turbo": "2.11.8",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@12.14.0"
}

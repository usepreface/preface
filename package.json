{
  "name": "preface",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm check:root && turbo run lint typecheck build",
    "check:root": "pnpm format:check && oxlint --deny-warnings . && tsc --noEmit -p tsconfig.json",
    "dev": "turbo run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings . && turbo run lint",
    "lint:fix": "oxlint --fix .",
    "prepare": "lefthook install",
    "test": "turbo run test",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@11.28.6"
}

PUBLIC_URL=http://localhost:8080
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=preface
POSTGRES_USERNAME=preface
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_SSL=false

# Console email is explicitly development-only and includes verification codes.
NODE_ENV=development
EMAIL_PROVIDER=development
EMAIL_FROM=Preface <preface@example.test>
# Generate each independently: openssl rand -base64 32
CRYPTO_ENCRYPTION_KEY=
CRYPTO_HMAC_KEY=
# Real-provider configuration is documented in packages/emails/README.md.

# Optional exact HTTPS origins for private-network OIDC providers (comma-separated).
# Organization configuration cannot override this deployment policy.
# OIDC_ALLOWED_PRIVATE_ORIGINS=https://identity.internal.example

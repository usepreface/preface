PUBLIC_URL=http://localhost:8080
# Optional frontend origin; leave empty for backend-only /api/docs completion.
DASHBOARD_URL=http://localhost:3000
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=preface
POSTGRES_USERNAME=preface
POSTGRES_PASSWORD=preface
POSTGRES_SSL=false

# Console email is explicitly development-only and includes verification codes.
NODE_ENV=development
EMAIL_PROVIDER=development
EMAIL_FROM=Preface <preface@example.test>
# Generate each independently: openssl rand -base64 32
CRYPTO_ENCRYPTION_KEY=
CRYPTO_HMAC_KEY=
# Real-provider configuration is documented in packages/emails/README.md.

# The local Keycloak service is the only development exception to public OIDC origins.
OIDC_ALLOWED_PRIVATE_ORIGINS=https://localhost:8443

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "klarity/tsconfig/library/react",
  "compilerOptions": {
    "customConditions": ["preface-source"],
    "rootDir": "src",
    // Components follow shadcn/ui, whose source assumes these two checks are off.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}

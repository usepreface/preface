{
  "name": "@usepreface/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Preface design system: Base UI components styled with the Preface tokens, icons, logos and brand marks.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./components/*": "./src/components/*.tsx",
    "./ai/*": "./src/components/ai/*.tsx",
    "./preface/*": "./src/components/preface/*.tsx",
    "./icons": "./src/icons/index.tsx",
    "./logos": "./src/logos/index.ts",
    "./logos/registry": "./src/logos/registry.tsx",
    "./brand": "./src/brand/index.tsx",
    "./illustrations": "./src/illustrations/index.ts",
    "./illustrations/registry": "./src/illustrations/registry.ts",
    "./objects": "./src/objects/index.ts",
    "./objects/registry": "./src/objects/registry.ts",
    "./patterns": "./src/patterns/index.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/highlighter": "./src/lib/highlighter.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "input-otp": "1.5.0",
    "react-day-picker": "10.0.2",
    "recharts": "3.10.1",
    "shiki": "4.5.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "klarity": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  }
}

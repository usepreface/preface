{
  "name": "@usepreface/emails",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": {
      "preface-source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "preface-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "preface-source": "./src/node/index.ts",
      "default": "./dist/node/index.js"
    },
    "./testing": {
      "preface-source": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./node": "./dist/node/index.js",
      "./testing": "./dist/testing/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "dev": "tsdown --config tsdown.config.ts --watch",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "NODE_OPTIONS=--conditions=preface-source vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1152.0",
    "@usepreface/crypto": "workspace:*",
    "@usepreface/database": "workspace:*",
    "@usepreface/protocol": "workspace:*",
    "effect": "catalog:",
    "inboundemail": "0.20.0",
    "nodemailer": "10.1.2",
    "resend": "6.32.1"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

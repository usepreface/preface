{
  "name": "@usepreface/database",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "files": [
    "dist",
    "migrations"
  ],
  "type": "module",
  "imports": {
    "#/*": {
      "preface-source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "preface-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "preface-source": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./testing": "./dist/testing/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "db:generate": "NODE_OPTIONS=--conditions=preface-source drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --conditions=preface-source src/migrations/run.ts",
    "db:studio": "node --env-file-if-exists=.env --conditions=preface-source ./node_modules/drizzle-kit/bin.cjs studio --config drizzle.studio.config.ts",
    "dev": "tsdown --config tsdown.config.ts --watch",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "NODE_OPTIONS=--conditions=preface-source vitest run",
    "test:built": "pnpm --workspace-root exec turbo run build --filter=@usepreface/database && node --test tests/smoke/built.test.mjs",
    "test:watch": "NODE_OPTIONS=--conditions=preface-source vitest"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.5",
    "@effect/sql-pg": "4.0.5",
    "@usepreface/protocol": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "catalog:",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@effect/sql-pglite": "4.0.5",
    "@effect/vitest": "4.0.5",
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "catalog:",
    "drizzle-kit": "1.0.0-rc.4",
    "klarity": "catalog:",
    "pg": "8.23.1",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

    {
      "value": "\"actor_kind\" in ('user', 'system')",
      "name": "event_actor_kind_check",
      "entityType": "checks",
      "schema": "audit",
      "table": "event"
    },
    {
      "value": "(\"actor_kind\" = 'user' and \"actor_user_id\" is not null)\n        or (\"actor_kind\" = 'system' and \"actor_user_id\" is null)",
      "name": "event_actor_attribution_check",
      "entityType": "checks",
      "schema": "audit",
      "table": "event"
    },
    {
      "value": "btrim(\"event_type\") <> ''",
      "name": "event_type_check",
      "entityType": "checks",
      "schema": "audit",
      "table": "event"
    },
    {
      "value": "btrim(\"target_type\") <> ''",
      "name": "event_target_type_check",
      "entityType": "checks",
      "schema": "audit",
      "table": "event"
    },
    {
      "value": "jsonb_typeof(\"metadata\") = 'object'",
      "name": "event_metadata_object_check",
      "entityType": "checks",
      "schema": "audit",
      "table": "event"
    },
    {
      "value": "\"attempts\" between 0 and 5",
      "name": "bootstrap_challenge_attempts_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "bootstrap_challenge"
    },
    {
      "value": "\"expires_at\" > \"created_at\"",
      "name": "bootstrap_challenge_expiry_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "bootstrap_challenge"
    },
    {
      "value": "\"status\" in ('pending', 'processing', 'sent', 'failed', 'expired', 'cancelled')",
      "name": "email_status_check",
      "entityType": "checks",
      "schema": "jobs",
      "table": "email"
    },
    {
      "value": "\"attempts\" >= 0",
      "name": "email_attempts_check",
      "entityType": "checks",
      "schema": "jobs",
      "table": "email"
    },
    {
      "value": "\"expires_at\" > \"created_at\"",
      "name": "email_expiry_check",
      "entityType": "checks",
      "schema": "jobs",
      "table": "email"
    },
    {
      "value": "(\"status\" = 'processing' and \"lease_token\" is not null and \"lease_expires_at\" is not null)\n    or (\"status\" <> 'processing' and \"lease_token\" is null and \"lease_expires_at\" is null)",
      "name": "email_lease_check",
      "entityType": "checks",
      "schema": "jobs",
      "table": "email"
    },
    {
      "value": "(\"status\" in ('pending', 'processing') and \"encrypted_payload\" is not null)\n    or (\"status\" in ('sent', 'failed', 'expired', 'cancelled') and \"encrypted_payload\" is null)",
      "name": "email_payload_check",
      "entityType": "checks",
      "schema": "jobs",
      "table": "email"
    },
    {
      "value": "\"id\" = 1",
      "name": "installation_singleton_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "installation"
    },
    {
      "value": "\n    (\"bootstrap_token_hash\" is null and \"bootstrap_token_issued_at\" is null and \"bootstrap_token_expires_at\" is null)\n    or (\"bootstrap_token_hash\" is not null and \"bootstrap_token_hash\" <> ''\n      and \"bootstrap_token_issued_at\" is not null and \"bootstrap_token_expires_at\" is not null)",
      "name": "installation_token_fields_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "installation"
    },
    {
      "value": "\"bootstrap_token_expires_at\" > \"bootstrap_token_issued_at\"",
      "name": "installation_token_expiry_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "installation"
    },
    {
      "value": "\"bootstrap_completed_at\" is null or \"bootstrap_token_hash\" is null",
      "name": "installation_completed_token_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "installation"
    },
    {
      "value": "\"grant_source\" in ('bootstrap', 'owner', 'operator_recovery')",
      "name": "owner_grant_source_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "owner"
    },
    {
      "value": "(\"grant_source\" = 'owner' and \"granted_by_user_id\" is not null)\n    or (\"grant_source\" in ('bootstrap', 'operator_recovery') and \"granted_by_user_id\" is null)",
      "name": "owner_grant_actor_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "owner"
    },
    {
      "value": "\"revoked_at\" >= \"granted_at\"",
      "name": "owner_revocation_time_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "owner"
    },
    {
      "value": "\"revoked_at\" is not null\n    or (\"revoked_by_user_id\" is null and \"revocation_reason\" is null)",
      "name": "owner_revocation_metadata_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "owner"
    },
    {
      "value": "\"revocation_reason\" is null or \"revocation_reason\" <> ''",
      "name": "owner_revocation_reason_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "owner"
    },
    {
      "value": "char_length(\"display_name\") between 1 and 120 and \"display_name\" = btrim(\"display_name\")",
      "name": "settings_display_name_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "settings"
    },
    {
      "value": "\"revision\" > 0",
      "name": "settings_revision_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "settings"
    },
    {
      "value": "\"password_hash\" <> ''",
      "name": "password_credential_hash_check",
      "entityType": "checks",
      "schema": "auth",
      "table": "password_credential"
    },
    {
      "value": "\"password_changed_at\" >= \"created_at\"",
      "name": "password_credential_change_time_check",
      "entityType": "checks",
      "schema": "auth",
      "table": "password_credential"
    },
    {
      "value": "\"token_hash\" ~ '^[0-9a-f]{64}$'",
      "name": "session_token_hash_check",
      "entityType": "checks",
      "schema": "auth",
      "table": "session"
    },
    {
      "value": "\"expires_at\" > \"created_at\"",
      "name": "session_expiry_check",
      "entityType": "checks",
      "schema": "auth",
      "table": "session"
    },
    {
      "value": "\"last_seen_at\" >= \"created_at\"",
      "name": "session_activity_time_check",
      "entityType": "checks",
      "schema": "auth",
      "table": "session"
    },
    {
      "value": "\"revoked_at\" >= \"created_at\"",
      "name": "session_revocation_time_check",
      "entityType": "checks",
      "schema": "auth",
      "table": "session"
    },
    {
      "value": "\"display_name\" = btrim(\"display_name\") and char_length(\"display_name\") between 1 and 120",
      "name": "user_display_name_check",
      "entityType": "checks",
      "schema": "auth",
      "table": "user"
    },
    {
      "value": "\"email\" <> '' and \"email\" = lower(btrim(\"email\"))",
      "name": "user_email_canonical_check",
      "entityType": "checks",
      "schema": "auth",
      "table": "user"
    }

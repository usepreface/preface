    {
      "value": "\"id\" = 1",
      "name": "installation_singleton_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "installation"
    },
    {
      "value": "\n    (\"bootstrap_token_hash\" is null and \"bootstrap_token_issued_at\" is null and \"bootstrap_token_expires_at\" is null)\n    or (\"bootstrap_token_hash\" is not null and \"bootstrap_token_hash\" <> ''\n      and \"bootstrap_token_issued_at\" is not null and \"bootstrap_token_expires_at\" is not null)",
      "name": "installation_token_fields_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "installation"
    },
    {
      "value": "\"bootstrap_token_expires_at\" > \"bootstrap_token_issued_at\"",
      "name": "installation_token_expiry_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "installation"
    },
    {
      "value": "\"bootstrap_completed_at\" is null or \"bootstrap_token_hash\" is null",
      "name": "installation_completed_token_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "installation"
    },
    {
      "value": "\"grant_source\" in ('bootstrap', 'owner', 'operator_recovery')",
      "name": "owner_grant_source_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "owner"
    },
    {
      "value": "(\"grant_source\" = 'owner' and \"granted_by_user_id\" is not null)\n    or (\"grant_source\" in ('bootstrap', 'operator_recovery') and \"granted_by_user_id\" is null)",
      "name": "owner_grant_actor_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "owner"
    },
    {
      "value": "\"revoked_at\" >= \"granted_at\"",
      "name": "owner_revocation_time_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "owner"
    },
    {
      "value": "\"revoked_at\" is not null\n    or (\"revoked_by_user_id\" is null and \"revocation_reason\" is null)",
      "name": "owner_revocation_metadata_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "owner"
    },
    {
      "value": "\"revocation_reason\" is null or \"revocation_reason\" <> ''",
      "name": "owner_revocation_reason_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "owner"
    },
    {
      "value": "char_length(\"display_name\") between 1 and 120 and \"display_name\" = btrim(\"display_name\")",
      "name": "settings_display_name_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "settings"
    },
    {
      "value": "\"revision\" > 0",
      "name": "settings_revision_check",
      "entityType": "checks",
      "schema": "instance",
      "table": "settings"
    }

# Used by docker compose. Replace this example before starting the stack.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_USERNAME=preface
POSTGRES_DATABASE=preface
PUBLIC_URL=http://localhost:8080
SERVER_PORT=8080
SERVER_BIND_ADDRESS=127.0.0.1

# Generate each key independently: openssl rand -base64 32
# Keep both stable across replicas/restarts and store them with database backups.
CRYPTO_ENCRYPTION_KEY=
CRYPTO_HMAC_KEY=

# Production requires a real provider: resend, inbound, ses, or smtp.
EMAIL_PROVIDER=resend
EMAIL_FROM=Preface <preface@example.com>
# EMAIL_REPLY_TO=support@example.com
RESEND_API_KEY=
# INBOUND_API_KEY=
# AWS_REGION=us-east-1
# SES uses the AWS default credential chain; for Compose, pass credentials or a role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Local Compose only: NODE_ENV=development and EMAIL_PROVIDER=development print codes.
# NODE_ENV=development

# Optional exact HTTPS origins for private-network OIDC providers (comma-separated).
# Organization configuration cannot override this deployment policy.
# OIDC_ALLOWED_PRIVATE_ORIGINS=https://identity.internal.example
